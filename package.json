{
  "name": "dsh-godot-play",
  "version": "0.3.0",
  "description": "在 DSH Web GUI 一键构建并试玩多个 Godot Web 导出：项目选择器 + 宿主半区直接跑 Godot 导出，装完即用、零外部进程",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "node tests/host-smoke.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "client-plugin",
    "godot",
    "web"
  ],
  "license": "MIT"
}
